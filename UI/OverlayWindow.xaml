<Window x:Class="PoE2Inspector.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PoE2 Inspector Overlay" 
        Height="1080" Width="1920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <!-- Item Analysis Panel - Appears near cursor -->
        <Border x:Name="AnalysisPanel" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Background="#F0121212"
                BorderBrush="#A38D6D"
                BorderThickness="2"
                CornerRadius="8"
                Padding="15"
                MinWidth="320"
                MaxWidth="400"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.8"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Header with close button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtItemName" Text="Nome do Item" 
                                   Foreground="#FFD700" FontSize="16" FontWeight="Bold" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtItemType" Text="Tipo Base" 
                                   Foreground="#A38D6D" FontSize="12"/>
                        <TextBlock x:Name="TxtItemRarity" Text="Raridade: -" 
                                   Foreground="#888" FontSize="11"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" x:Name="BtnClose" Content="✕" 
                            Width="24" Height="24" 
                            Background="Transparent" Foreground="#FF6B6B" 
                            BorderThickness="0" FontSize="14" FontWeight="Bold"
                            VerticalAlignment="Top" Cursor="Hand"
                            Click="BtnClose_Click"/>
                </Grid>
                
                <Separator Grid.Row="1" Background="#A38D6D" Margin="0,10"/>
                
                <!-- Price Section -->
                <Border Grid.Row="2" Background="#1A1A1A" CornerRadius="5" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="💰 Preço Estimado" Foreground="#4CAF50" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtPrice" Text="Carregando..." 
                                   Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TxtPriceInfo" Text="Baseado em X listagens" 
                                   Foreground="#888" FontSize="10"/>
                    </StackPanel>
                </Border>
                
                <!-- Quality Score -->
                <Border Grid.Row="3" Background="#1A1A1A" CornerRadius="5" Padding="10" Margin="0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⭐ Qualidade" Foreground="#FFD700" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtQualityDesc" Text="Avaliação do item" 
                                       Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtQualityScore" Text="?" 
                                       Foreground="#4CAF50" FontSize="28" FontWeight="Bold" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/10" Foreground="#888" FontSize="12" 
                                       HorizontalAlignment="Center" Margin="0,-5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Mods Analysis -->
                <Border Grid.Row="4" Background="#1A1A1A" CornerRadius="5" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="📊 Análise de Mods" Foreground="#2196F3" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtModsAnalysis" Text="Analisando..." 
                                   Foreground="#CCC" FontSize="11" TextWrapping="Wrap" 
                                   Margin="0,5,0,0" MaxHeight="150"/>
                    </StackPanel>
                </Border>
                
                <!-- Verdict -->
                <Border Grid.Row="5" x:Name="VerdictBorder" Background="#1A4D1A" CornerRadius="5" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="📋 Veredicto" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBlock x:Name="TxtVerdict" Text="Item sendo analisado..." 
                                   Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Action Buttons -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="BtnOpenTrade" Content="🔍 Abrir Trade" 
                            Padding="15,8" Margin="0,0,5,0"
                            Background="#2D5A27" Foreground="White" 
                            BorderBrush="#4CAF50" BorderThickness="1"
                            Cursor="Hand" Click="BtnOpenTrade_Click"/>
                    <Button x:Name="BtnCopyPrice" Content="📋 Copiar Preço" 
                            Padding="15,8" Margin="5,0,0,0"
                            Background="#1A3A5C" Foreground="White" 
                            BorderBrush="#2196F3" BorderThickness="1"
                            Cursor="Hand" Click="BtnCopyPrice_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading indicator -->
        <Border x:Name="LoadingPanel" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top"
                Background="#F0121212"
                BorderBrush="#A38D6D"
                BorderThickness="2"
                CornerRadius="8"
                Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="⏳ Analisando item..." Foreground="#A38D6D" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
